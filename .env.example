# === Обязательные ===
# Пароль входа в CRM
APP_PASSWORD=change-me
# Длинная случайная строка для подписи сессий (openssl rand -hex 32)
SECRET_KEY=change-me-long-random
# Пароль Postgres (для локального compose можно оставить)
POSTGRES_PASSWORD=crm

# === Почта (Gmail API) — можно оставить пустыми, подсистема просто спит ===
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# === LLM (OpenRouter) — без ключа письма копятся в очереди ручного разбора ===
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# === Прочее ===
MAIL_WORKER_ENABLED=true
# На проде за HTTPS/Cloudflare обязательно включить:
# COOKIE_SECURE=true
# Порты на хосте (поменяйте, если заняты другими проектами)
# BACKEND_PORT=8000
# FRONTEND_PORT=3000

# Базовый URL бэкенда для OAuth-callback (на VPS поменять на https://домен)
PUBLIC_BASE_URL=http://localhost:8000
# Куда редиректить после подключения Gmail
FRONTEND_BASE_URL=http://localhost:3000
